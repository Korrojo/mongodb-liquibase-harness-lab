{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartOnlyTheExistingLabDelegate",
      "Effect": "Allow",
      "Action": "ec2:StartInstances",
      "Resource": "arn:aws:ec2:us-east-1:224772450208:instance/i-0635332c43aa733a5"
    },
    {
      "Sid": "ReadDelegateStartupState",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:DescribeInstanceStatus"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}
    }
  ]
}
