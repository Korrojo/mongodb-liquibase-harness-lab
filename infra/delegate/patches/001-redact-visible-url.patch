diff --git a/src/main/java/liquibase/ext/mongodb/database/MongoConnection.java b/src/main/java/liquibase/ext/mongodb/database/MongoConnection.java
index d1b92a2..d0d319d 100644
--- a/src/main/java/liquibase/ext/mongodb/database/MongoConnection.java
+++ b/src/main/java/liquibase/ext/mongodb/database/MongoConnection.java
@@ -142,3 +142,8 @@ public class MongoConnection extends AbstractNoSqlConnection {
     public String getVisibleUrl() {
-        return ofNullable(connectionString).map(ConnectionString::getConnectionString)
+        // A displayed URL must never contain user info or connection options,
+        // which can themselves carry authentication material.
+        return ofNullable(connectionString)
+                .map(value -> (value.isSrvProtocol() ? MONGO_DNS_PREFIX : MONGO_PREFIX)
+                        + String.join(",", value.getHosts())
+                        + ofNullable(value.getDatabase()).map(name -> "/" + name).orElse(""))
                 .orElseGet(super::getVisibleUrl);
