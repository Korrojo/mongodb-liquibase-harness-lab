+package liquibase.ext.mongodb.tools;
+
+import com.mongodb.ConnectionString;
+import liquibase.Scope;
+import liquibase.changelog.ChangeSet;
+import liquibase.database.Database;
+import liquibase.ext.mongodb.database.MongoConnection;
+import liquibase.ext.mongodb.database.MongoLiquibaseDatabase;
+import liquibase.logging.LogService;
+import liquibase.logging.Logger;
+import liquibase.sql.Sql;
+import liquibase.sql.UnparsedSql;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Properties;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.*;
+
+class MongoshRunnerSecurityTest {
+    private static final String PASSWORD = "LAB_NATIVE_CANARY@+!916";
+    private static final String ENCODED_PASSWORD = "LAB_NATIVE_CANARY%40%2B%21916";
+    private static final String URI = "mongodb://offline_user:" + ENCODED_PASSWORD
+            + "@127.0.0.1:1/liquibase_lab?serverSelectionTimeoutMS=500&connectTimeoutMS=500";
+    private static final String CONNECTION_ENV = "LIQUIBASE_MONGOSH_CONNECTION_URI";
+
+    @TempDir
+    Path directory;
+
+    private MongoLiquibaseDatabase database() {
+        MongoConnection connection = new MongoConnection();
+        connection.setConnectionString(new ConnectionString(URI));
+        MongoLiquibaseDatabase database = mock(MongoLiquibaseDatabase.class);
+        when(database.getConnection()).thenReturn(connection);
+        return database;
+    }
+
+    private Path executable(String body) throws Exception {
+        Path file = Files.createTempFile(directory, "fake-mongosh-", ".sh");
+        Files.write(file, body.getBytes(StandardCharsets.UTF_8));
+        Files.setPosixFilePermissions(file, PosixFilePermissions.fromString("rwx------"));
+        return file;
+    }
+
+    private class ObservedRunner extends MongoshRunner {
+        final Path executable;
+        Path script;
+        boolean environmentChecked;
+        long limit = 10000;
+        Path outputLog;
+
+        ObservedRunner(Path executable) {
+            super(mock(ChangeSet.class), new Sql[]{new UnparsedSql("print('SCRIPT_EXECUTED')")});
+            this.executable = executable;
+        }
+
+        @Override
+        public Properties getPropertiesFromConf(String ignored) {
+            Properties properties = new Properties();
+            properties.setProperty("liquibase.mongosh.path", executable.toString());
+            if (outputLog != null) properties.setProperty("liquibase.mongosh.logFile", outputLog.toString());
+            return properties;
+        }
+
+        @Override
+        protected long getTimeoutInMillis() {
+            return limit;
+        }
+
+        @Override
+        protected ProcessBuilder createProcessBuilder(Database database) {
+            ProcessBuilder builder = super.createProcessBuilder(database);
+            assertEquals(URI, builder.environment().get(CONNECTION_ENV));
+            assertClean(String.join(" ", builder.command()));
+            assertTrue(builder.command().contains("--nodb"));
+            script = Paths.get(builder.command().get(builder.command().indexOf("--file") + 1));
+            try {
+                assertEquals(PosixFilePermissions.fromString("rw-------"), Files.getPosixFilePermissions(script));
+                String contents = new String(Files.readAllBytes(script), StandardCharsets.UTF_8);
+                assertClean(contents);
+                assertTrue(contents.contains("delete process.env." + CONNECTION_ENV));
+                assertTrue(contents.indexOf("connect(process.env.") < contents.indexOf("SCRIPT_EXECUTED"));
+            } catch (Exception e) {
+                throw new AssertionError(e);
+            }
+            environmentChecked = true;
+            return builder;
+        }
+    }
+
+    private static void assertClean(String text) {
+        assertFalse(text.contains(PASSWORD), "Raw password must not be exposed");
+        assertFalse(text.contains(ENCODED_PASSWORD), "Encoded password must not be exposed");
+        assertFalse(text.contains(URI), "Connection URI must not be exposed");
+    }
+
+    private List<String> runWithCapturedLogs(ObservedRunner runner, boolean failure) throws Exception {
+        List<String> messages = new ArrayList<>();
+        Logger logger = mock(Logger.class, invocation -> {
+            for (Object arg : invocation.getArguments()) {
+                if (arg instanceof String) messages.add((String) arg);
+            }
+            return RETURNS_DEFAULTS.answer(invocation);
+        });
+        LogService service = mock(LogService.class);
+        when(service.getLog(any())).thenReturn(logger);
+        Scope.child(Collections.singletonMap(Scope.Attr.logService.name(), service), () -> {
+            if (failure) {
+                Exception exception = assertThrows(Exception.class, () -> runner.executeCommand(database()));
+                for (Throwable cause = exception; cause != null; cause = cause.getCause()) {
+                    assertClean(String.valueOf(cause.getMessage()));
+                }
+            } else {
+                runner.executeCommand(database());
+            }
+        });
+        assertTrue(runner.environmentChecked);
+        assertNotNull(runner.script);
+        assertFalse(Files.exists(runner.script), "Temporary script must be removed immediately");
+        messages.forEach(MongoshRunnerSecurityTest::assertClean);
+        return messages;
+    }
+
+    @Test
+    void successDoesNotExposeCredentialsInArgumentsFilesOrLogs() throws Exception {
+        Path fake = executable("#!/bin/sh\nprintf '%s\\n' \"$LIQUIBASE_MONGOSH_CONNECTION_URI\"\n"
+                + "printf '%s\\n' '" + PASSWORD + "' '" + ENCODED_PASSWORD + "'\nexit 0\n");
+        List<String> messages = runWithCapturedLogs(new ObservedRunner(fake), false);
+        assertTrue(String.join("\n", messages).contains("<mongodb connection>"));
+    }
+
+    @Test
+    void failedChildRedactsStdoutStderrAndException() throws Exception {
+        Path fake = executable("#!/bin/sh\nprintf '%s\\n' \"$LIQUIBASE_MONGOSH_CONNECTION_URI\"\n"
+                + "printf '%s\\n' '" + PASSWORD + "' >&2\nexit 17\n");
+        runWithCapturedLogs(new ObservedRunner(fake), true);
+    }
+
+    @Test
+    void configuredLogFileAlsoContainsOnlyRedactedOutput() throws Exception {
+        ObservedRunner runner = new ObservedRunner(executable("#!/bin/sh\n"
+                + "printf '%s\\n' \"$LIQUIBASE_MONGOSH_CONNECTION_URI\"\nexit 7\n"));
+        runner.outputLog = directory.resolve("native.log");
+        runWithCapturedLogs(runner, true);
+        String log = new String(Files.readAllBytes(runner.outputLog), StandardCharsets.UTF_8);
+        assertClean(log);
+        assertTrue(log.contains("<mongodb connection>"));
+    }
+
+    @Test
+    void oversizedOutputIsDrainedAndSuppressedWithoutPartialSecrets() throws Exception {
+        ObservedRunner runner = new ObservedRunner(executable("#!/bin/sh\n"
+                + "head -c 1100000 /dev/zero\n"
+                + "printf '%s\\n' \"$LIQUIBASE_MONGOSH_CONNECTION_URI\"\nexit 0\n"));
+        List<String> messages = runWithCapturedLogs(runner, false);
+        assertTrue(String.join("\n", messages).contains("output exceeded 1 MiB; output suppressed"));
+    }
+
+    @Test
+    void failedProcessStartStillRemovesScript() throws Exception {
+        runWithCapturedLogs(new ObservedRunner(executable("#!/nonexistent/lab-interpreter\n")), true);
+    }
+
+    @Test
+    void timeoutFailsAndRemovesScript() throws Exception {
+        ObservedRunner runner = new ObservedRunner(executable("#!/bin/sh\nexec sleep 30\n"));
+        runner.limit = 100;
+        long started = System.nanoTime();
+        runWithCapturedLogs(runner, true);
+        assertTrue(System.nanoTime() - started < 5_000_000_000L);
+    }
+
+    @Test
+    void rejectsCredentialArgumentsBeforeCreatingScript() throws Exception {
+        ObservedRunner runner = new ObservedRunner(executable("#!/bin/sh\nexit 0\n"));
+        runner.addArg("--password");
+        runner.addArg(PASSWORD);
+        Exception exception = assertThrows(Exception.class, () -> runner.executeCommand(database()));
+        assertClean(exception.toString());
+        assertNull(runner.script);
+    }
+
+    @Test
+    void actualMongoshConnectionFailureIsSafe() throws Exception {
+        String path = System.getProperty("lab.mongosh");
+        assumeTrue(path != null, "Set lab.mongosh to the actual executable for the native negative check");
+        List<String> messages = runWithCapturedLogs(new ObservedRunner(Paths.get(path)), true);
+        assertTrue(String.join("\n", messages).contains("Native MongoDB connection failed"));
+        assertFalse(String.join("\n", messages).contains("SCRIPT_EXECUTED"));
+    }
+}
