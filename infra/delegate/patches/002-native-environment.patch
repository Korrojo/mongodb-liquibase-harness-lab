+    private String captureOutput(InputStream input) throws IOException {
+        try (InputStream stream = input; ByteArrayOutputStream captured = new ByteArrayOutputStream()) {
+            byte[] bytes = new byte[4096];
+            boolean overflow = false;
+            int count;
+            while ((count = stream.read(bytes)) != -1) {
+                if (!overflow && captured.size() + count <= 1024 * 1024) {
+                    captured.write(bytes, 0, count);
+                } else {
